<mxfile host="app.diagrams.net">
  <diagram id="docker-quiz-architecture" name="Application">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Docker Quiz - Application Architecture" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="20 questions: 10 multiple-choice + 10 blanks | Server-side grading | Persistent leaderboard" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontSize=16;fontColor=#52616B;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="host" value="Host machine - Docker Desktop / Docker Compose" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;fillColor=#F8FAFC;strokeColor=#9AA7B2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=20;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="1360" height="710" as="geometry" />
        </mxCell>
        <mxCell id="network" value="game-network (bridge) - Internal communication using Docker service names" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;fillColor=#EFF6FF;strokeColor=#6B9BC3;dashed=1;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="370" width="1070" height="260" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nickname and answers&lt;br&gt;Score and explanations&lt;br&gt;Leaderboard" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="170" height="160" as="geometry" />
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;Front build: Node.js&lt;/b&gt;&lt;br&gt;node:20-alpine&lt;br&gt;npm ci + npm run build&lt;br&gt;Output: dist/index.html" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#5B9E6F;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="build-note" value="Multi-stage build: only static files are copied.&lt;br&gt;Node.js is absent from the front runtime image." style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontColor=#52616B;" vertex="1" parent="1">
          <mxGeometry x="590" y="250" width="650" height="70" as="geometry" />
        </mxCell>
        <mxCell id="front" value="&lt;b&gt;FRONT / WEB&lt;/b&gt;&lt;br&gt;Service: front | NGINX&lt;br&gt;&lt;br&gt;Static files + /api/ proxy&lt;br&gt;Internal port: 80&lt;br&gt;Healthcheck: GET /&lt;br&gt;Default: 0.25 CPU | 64 MiB" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#D9EAF7;strokeColor=#3876A3;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API / BACK&lt;/b&gt;&lt;br&gt;Service: api | Python&lt;br&gt;&lt;br&gt;Requests and score storage&lt;br&gt;Internal port: 5000&lt;br&gt;Healthcheck: /health + SQLite&lt;br&gt;Default: 2 CPUs | 128 MiB" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#B59B32;" vertex="1" parent="1">
          <mxGeometry x="660" y="420" width="240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="game" value="&lt;b&gt;GAME SERVER&lt;/b&gt;&lt;br&gt;Service: game-server | Node.js&lt;br&gt;&lt;br&gt;Questions and grading&lt;br&gt;Internal port: 4000&lt;br&gt;Healthcheck: GET /status&lt;br&gt;Default: 0.5 CPU | 128 MiB" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#60995C;" vertex="1" parent="1">
          <mxGeometry x="1020" y="420" width="240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="volume" value="&lt;b&gt;Named volume: quiz-data&lt;/b&gt;&lt;br&gt;API mount: /data&lt;br&gt;SQLite: /data/quiz.db&lt;br&gt;Survives container recreation" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="650" y="710" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="config" value="&lt;b&gt;Configuration and startup&lt;/b&gt;&lt;br&gt;compose.yaml + .env&lt;br&gt;Ports, resources, API variables&lt;br&gt;Healthchecks every 10 seconds&lt;br&gt;game-server healthy, then API&lt;br&gt;API healthy, then front starts&lt;br&gt;No automatic restart policy" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="670" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="security" value="&lt;b&gt;Host port exposure&lt;/b&gt;&lt;br&gt;&lt;br&gt;Default: 127.0.0.1:3000 to front:80&lt;br&gt;API and game server: no host port&lt;br&gt;Lint and tests run separately (see CI tabs)." style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="990" y="670" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid arrows: HTTP requests (JSON responses return on the same connections) or storage | Dashed: build-time copy" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontSize=14;fontColor=#52616B;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="browser-front" value="HTTP&lt;br&gt;3000 to 80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="front">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="front-api" value="HTTP /api/*&lt;br&gt;api:5000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="front" target="api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-28" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="api-game" value="HTTP&lt;br&gt;game-server:4000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="game">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-28" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="api-volume" value="SQLite read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="volume">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="build-front" value="COPY --from=build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#5B9E6F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="build" target="front">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="-25" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="docker-quiz-lint" name="Lint CI">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lint-title" value="Lint - Separate CI Job" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lint-subtitle" value="compose.lint.yaml | Project: docker-quiz-lint | No application startup required" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontColor=#52616B;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lint-host" value="Host machine / Docker" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;fillColor=#F8FAFC;strokeColor=#9AA7B2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=20;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="1160" height="600" as="geometry" />
        </mxCell>
        <mxCell id="lint-sources" value="&lt;b&gt;Repository sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;front/ (JS + HTML scripts)&lt;br&gt;api/ (Python)&lt;br&gt;game-server/ (JS)&lt;br&gt;scripts/ and tests/" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#D9EAF7;strokeColor=#3876A3;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lint-container" value="&lt;b&gt;LINT CONTAINER&lt;/b&gt;&lt;br&gt;node:20-alpine + custom tooling&lt;br&gt;&lt;br&gt;ESLint + HTML script plugin&lt;br&gt;Ruff for Python&lt;br&gt;USER node | /workspace&lt;br&gt;1 CPU | 256 MiB (defaults)" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#B59B32;" vertex="1" parent="1">
          <mxGeometry x="520" y="300" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lint-result" value="&lt;b&gt;CI result&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exit 0: all checks passed&lt;br&gt;Exit 1: a check failed&lt;br&gt;&lt;br&gt;--exit-code-from lint" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#60995C;" vertex="1" parent="1">
          <mxGeometry x="920" y="320" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lint-isolation" value="&lt;b&gt;Runtime isolation&lt;/b&gt;&lt;br&gt;Read-only source mounts&lt;br&gt;network_mode: none&lt;br&gt;No published port&lt;br&gt;No database volume or Docker socket" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lint-build" value="&lt;b&gt;Build and configuration&lt;/b&gt;&lt;br&gt;apk: python3 + pip; /opt/venv&lt;br&gt;npm ci + pinned Ruff installation&lt;br&gt;LINT_CPUS and LINT_MEMORY via Compose&lt;br&gt;CMD: node /opt/lint/run.mjs" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="580" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lint-note" value="One-shot job&lt;br&gt;No healthcheck&lt;br&gt;No automatic fixes&lt;br&gt;Not a functional test service" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="580" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lint-mount" value="Read-only bind mounts&lt;br&gt;Source access, not HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="lint-sources" target="lint-container">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lint-exit" value="Process exit&lt;br&gt;status" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lint-container" target="lint-result">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram id="docker-quiz-tests" name="Tests CI">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="850">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="test-title" value="&lt;b&gt;Tests - Separate CI Job&lt;/b&gt;&lt;br&gt;compose.test.yaml | Project: docker-quiz-test" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#D9EAF7;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="test-isolation" value="Project-scoped network and volume | No host ports | No Docker socket&lt;br&gt;Health-gated startup: game-server, then API, then front, then tests" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#FFFFFF;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="test-runner" value="&lt;b&gt;TEST CONTAINER&lt;/b&gt;&lt;br&gt;Python unittest + urllib&lt;br&gt;USER tester&lt;br&gt;1 CPU | 128 MiB&lt;br&gt;TEST_BASE_URL=http://front" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#FFF2CC;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="270" height="190" as="geometry" />
        </mxCell>
        <mxCell id="test-front" value="&lt;b&gt;FRONT&lt;/b&gt;&lt;br&gt;NGINX :80&lt;br&gt;Static HTML + API proxy&lt;br&gt;0.25 CPU | 64 MiB" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#D9EAF7;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="230" height="190" as="geometry" />
        </mxCell>
        <mxCell id="test-api" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;Python :5000&lt;br&gt;Score validation/storage&lt;br&gt;2 CPUs | 128 MiB" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#D5E8D4;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="730" y="280" width="230" height="190" as="geometry" />
        </mxCell>
        <mxCell id="test-game" value="&lt;b&gt;GAME SERVER&lt;/b&gt;&lt;br&gt;Node :4000&lt;br&gt;Questions + grading&lt;br&gt;0.5 CPU | 128 MiB" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#D9EAF7;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="1060" y="280" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="test-volume" value="&lt;b&gt;Test-only quiz-data volume&lt;/b&gt;&lt;br&gt;API mount: /data/quiz.db&lt;br&gt;Separate from normal scores" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#D5E8D4;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="690" y="550" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="test-result" value="&lt;b&gt;CI result&lt;/b&gt;&lt;br&gt;Exit 0: pass | Exit 1: failure/error&lt;br&gt;--exit-code-from test&lt;br&gt;Application stops when job exits" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#FFF2CC;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="test-cleanup" value="&lt;b&gt;Cleanup / fresh test data&lt;/b&gt;&lt;br&gt;docker compose -f compose.test.yaml down -v&lt;br&gt;Remove only the test project resources" style="whiteSpace=wrap;html=1;rounded=1;spacing=14;fontSize=16;fillColor=#FFFFFF;strokeColor=#78909C;" vertex="1" parent="1">
          <mxGeometry x="490" y="730" width="850" height="80" as="geometry" />
        </mxCell>
        <mxCell id="test-http" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="test-runner" target="test-front">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="test-proxy" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="test-front" target="test-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="test-grading" value="HTTP :4000" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="test-api" target="test-game">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="test-storage" value="SQLite" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="test-api" target="test-volume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="test-exit" value="Process exit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="test-runner" target="test-result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
