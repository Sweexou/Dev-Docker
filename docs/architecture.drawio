<mxfile host="app.diagrams.net"><diagram id="docker-quiz-architecture" name="Architecture Quiz Docker"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Quiz Docker - Architecture des 3 services" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1300" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="20 questions : 10 QCM + 10 textes a trous | Correction cote serveur | Classement persistant" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontSize=16;fontColor=#52616B;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1300" height="40" as="geometry"/></mxCell>
<mxCell id="host" value="Machine hote - Docker Desktop / Docker Compose" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;fillColor=#F8FAFC;strokeColor=#9AA7B2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=20;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="1360" height="710" as="geometry"/></mxCell>
<mxCell id="network" value="game-network (bridge) - Communication par noms de services Docker" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;fillColor=#EFF6FF;strokeColor=#6B9BC3;dashed=1;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="370" width="1070" height="260" as="geometry"/></mxCell>
<mxCell id="browser" value="&lt;b&gt;Navigateur&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pseudo et reponses&lt;br&gt;Score et correction&lt;br&gt;Classement" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="170" height="160" as="geometry"/></mxCell>
<mxCell id="build" value="&lt;b&gt;Build du front : Node.js&lt;/b&gt;&lt;br&gt;node:20-alpine&lt;br&gt;npm ci + npm run build&lt;br&gt;Sortie : dist/index.html" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#5B9E6F;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="build-note" value="Build multi-stage : seuls les fichiers statiques sont copies.&lt;br&gt;Node.js n'est pas present dans l'image finale du front." style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontColor=#52616B;" vertex="1" parent="1"><mxGeometry x="590" y="250" width="650" height="70" as="geometry"/></mxCell>
<mxCell id="front" value="&lt;b&gt;FRONT / WEB&lt;/b&gt;&lt;br&gt;Service : front&lt;br&gt;NGINX&lt;br&gt;&lt;br&gt;HTML / CSS / JavaScript&lt;br&gt;Fichiers statiques + proxy /api/&lt;br&gt;Port interne : 80" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#D9EAF7;strokeColor=#3876A3;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;API / BACK&lt;/b&gt;&lt;br&gt;Service : api&lt;br&gt;Python&lt;br&gt;&lt;br&gt;Questions et soumissions&lt;br&gt;Sauvegarde / lecture des scores&lt;br&gt;Port interne : 5000" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#B59B32;" vertex="1" parent="1"><mxGeometry x="660" y="420" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="game" value="&lt;b&gt;GAME SERVER&lt;/b&gt;&lt;br&gt;Service : game-server&lt;br&gt;Node.js&lt;br&gt;&lt;br&gt;20 questions / bonnes reponses&lt;br&gt;Correction et calcul du score&lt;br&gt;Port interne : 4000" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#60995C;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="volume" value="&lt;b&gt;Volume nomme : quiz-data&lt;/b&gt;&lt;br&gt;Monte dans l'API : /data&lt;br&gt;SQLite : /data/quiz.db&lt;br&gt;Scores conserves apres recreation" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="650" y="710" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="config" value="&lt;b&gt;Configuration et orchestration&lt;/b&gt;&lt;br&gt;compose.yaml&lt;br&gt;Builds, reseau, volume, variables&lt;br&gt;depends_on : game-server, API, front&lt;br&gt;Ordre de lancement uniquement&lt;br&gt;(pas d'attente de disponibilite)" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="670" width="330" height="170" as="geometry"/></mxCell>
<mxCell id="security" value="&lt;b&gt;Exposition des ports&lt;/b&gt;&lt;br&gt;&lt;br&gt;Front : 127.0.0.1:3000 -&amp;gt; 80&lt;br&gt;API et game server : aucun port publie&lt;br&gt;Le reseau bridge n'est pas un pare-feu." style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="670" width="330" height="170" as="geometry"/></mxCell>
<mxCell id="legend" value="Fleches pleines : requetes HTTP (reponses JSON en retour) et stockage | Fleche pointillee : copie pendant le build" style="whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;spacing=12;text;align=left;fontSize=14;fontColor=#52616B;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1300" height="40" as="geometry"/></mxCell>
<mxCell id="browser-front" value="HTTP&lt;br&gt;3000 -&amp;gt; 80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="front"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell>
<mxCell id="front-api" value="HTTP /api/*&lt;br&gt;api:5000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="front" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell>
<mxCell id="api-game" value="HTTP&lt;br&gt;game-server:4000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="game"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell>
<mxCell id="api-volume" value="Lecture / ecriture SQLite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="volume"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="build-front" value="COPY --from=build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#5B9E6F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="build" target="front"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="-25" as="offset"/></mxGeometry></mxCell>
</root></mxGraphModel></diagram></mxfile>
